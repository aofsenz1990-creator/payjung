# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น git)
# ค่าทั้งหมดหาได้จาก Supabase Dashboard ของโปรเจกต์เดียวกัน

# --- Supabase > Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon key (public) ของโปรเจกต์"

# service_role key — ใช้สร้าง/ลบบัญชีผู้ใช้และตั้งรหัสผ่านใหม่
# ⚠ เป็นความลับสูงสุด ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามเอาไปใช้ฝั่งเบราว์เซอร์
SUPABASE_SERVICE_ROLE_KEY="service_role key ของโปรเจกต์"

# --- Supabase > Project Settings > Database > Connection string > Transaction pooler ---
# อย่าลืมแทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูลที่ตั้งไว้ตอนสร้างโปรเจกต์
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
