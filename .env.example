# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local ขึ้น git)

# Connection string ของ Neon Postgres
# บน Vercel: Storage -> Create Database -> Neon  ระบบจะใส่ค่านี้ให้อัตโนมัติ
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# กุญแจสำหรับเซ็น session cookie  (สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ ของคุณเอง"
